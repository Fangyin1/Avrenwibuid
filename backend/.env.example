# PostgreSQL (Supabase) connection string; use SQLite locally if omitted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
ADMIN_TOKEN=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:3000

# Add only sources you own or are authorized to crawl.
# CSS selectors are examples and must be verified against the permitted source.
SCRAPE_SOURCES_JSON=[]

STREAM_ALLOWED_HOSTS=media.example.org,player.example.org
